<h1>New Course</h1>

<%= form_with model: @course, url: courses_path, method: :post do |f| %>
  <% if @course.errors.any? %>
    <div class="errors">
      <h3><%= pluralize(@course.errors.count, "error") %> prohibited this course from being saved:</h3>
      <ul><% @course.errors.full_messages.each { |m| %><li><%= m %></li><% } %></ul>
    </div>
  <% end %>

  <div>
    <%= f.label :coding_class_id, "Coding class" %><br>
    <%= f.collection_select :coding_class_id, @coding_classes, :id, :title, prompt: "Select a class" %>
  </div>

  <div>
    <%= f.label :trimester_id, "Trimester" %><br>
    <%= f.collection_select :trimester_id, @trimesters, :id, :display_name, prompt: "Select a trimester" %>
  </div>

  <div>
    <%= f.label :max_enrollment %><br>
    <%= f.number_field :max_enrollment, min: 1 %>
  </div>

  <%= f.submit "Create Course" %>
<% end %>

<div>
  <%= link_to "Back to courses", courses_path %>
</div>

<h1>Admin Dashboard</h1>

<% if @current_trimester.present? %>
  <h2><%= "#{@current_trimester.term} - #{@current_trimester.year}" %> Courses</h2>
  <ul>
    <% @current_trimester.courses.includes(:coding_class).each do |course| %>
      <li><%= link_to course.coding_class.title, course_path(course) %></li>
    <% end %>
  </ul>
<% end %>

<% if @upcoming_trimester.present? %>
  <h2><%= "#{@upcoming_trimester.term} - #{@upcoming_trimester.year}" %> Courses</h2>
  <ul>
    <% @upcoming_trimester.courses.includes(:coding_class).each do |course| %>
      <li><%= link_to course.coding_class.title, course_path(course) %></li>
    <% end %>
  </ul>
<% end %>
